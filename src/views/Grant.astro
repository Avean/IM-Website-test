---
// Strona projektu (powstaje dla każdego projektu): metadane z karty projektu, a pod nimi opis — jeśli jest.
import { render } from 'astro:content';
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import { u } from '../lib/url';
import { wJezyku, wybierz, RODZAJE_GRANTOW } from '../lib/i18n';
import { today, type Lang } from '../lib/daty';
import { granty, pracownicy, zaklady, zakladGrantu, osobaGrantu, slugOf, type Grant } from '../lib/tresci';

interface Props { grant: Grant; lang: Lang }
const { grant, lang } = Astro.props;
const d = grant.data;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const tytul = (lang === 'en' && d.tytul_en) || d.tytul;
// tytuł w drugim języku (pod nagłówkiem), jeśli jest
const tytulDrugi = lang === 'en' ? (d.tytul_en ? { tekst: d.tytul, lang: 'pl' } : undefined) : d.tytul_en ? { tekst: d.tytul_en, lang: 'en' } : undefined;
const maOpis = !!grant.body?.trim();
const { Content } = await render(grant);
const lata = (g: Grant) => (g.data.rok_od && g.data.rok_do && g.data.rok_od !== g.data.rok_do ? `${g.data.rok_od}–${g.data.rok_do}` : String(g.data.rok_od ?? g.data.rok_do ?? ''));
const okres = lata(grant);
const trwa = d.rok_do !== undefined && d.rok_do >= Number(today().slice(0, 4));
const rodzaj = RODZAJE_GRANTOW[d.rodzaj][lang];

// Kierownik (albo kilku, rozdzielonych przecinkami) ze spisu pracowników: link do strony domowej, a gdy jej brak — do zakładu.
// Fragment z samym tytułem („dr hab. Jan Dymara, prof. UWr”, „dr hab., prof. UWr Jan Dymara”) zostaje przy sąsiedniej osobie.
const osoby = await pracownicy();
const TYTUL = /^(prof|dr|hab|inż|mgr|uwr)$/i;
const kierownicy: { tekst: string; strona?: string; zaklad?: string }[] = [];
let przedrostek = '';
for (const czesc of (d.kierownik ?? '').split(/[,;]/).map((s) => s.trim()).filter(Boolean)) {
  const zImieniem = czesc.split(/[\s.]+/).some((w) => /\p{L}/u.test(w) && !TYTUL.test(w.replace(/[^\p{L}]/gu, '')));
  if (!zImieniem) {
    if (kierownicy.length) kierownicy[kierownicy.length - 1].tekst += `, ${czesc}`;
    else przedrostek += `${czesc}, `;
    continue;
  }
  const o = osobaGrantu(czesc, osoby);
  kierownicy.push({ tekst: przedrostek + czesc, strona: o?.data.strona, zaklad: o?.data.zaklad });
  przedrostek = '';
}
if (!kierownicy.length && d.kierownik) kierownicy.push({ tekst: d.kierownik });
const zakladId = zakladGrantu(grant, osoby);
const wszystkieZaklady = await zaklady();
const zaklad = wszystkieZaklady.find((z) => z.id === zakladId);
const adresZakladu = (id: string) => u(wJezyku(`/instytut/zaklady/${id}`, lang));
const adresGrantu = (g: Grant) => u(wJezyku(`/nauka/granty/${slugOf(g.id)}`, lang));

// Inne projekty tego samego zakładu (najnowsze), do bocznej ramki.
const inne = zaklad ? (await granty()).filter((g) => g.id !== grant.id && zakladGrantu(g, osoby) === zaklad.id) : [];
const opis = [`${T('Projekt', 'Project')}: ${rodzaj}${d.program ? ` (${d.program})` : ''}`, okres, d.kierownik ? `${T('kierownik', 'PI')}: ${d.kierownik}` : '']
  .filter(Boolean)
  .join(', ');
---
<Baza tytul={tytul} opis={opis} opublikowany={d.opublikowany}>
  <NaglowekStrony tytul={tytul} lang={lang} wstecz={{ etykieta: T('Wszystkie projekty i granty', 'All projects and grants'), adres: '/nauka/granty' }}>
    {tytulDrugi && <p class="lead" lang={tytulDrugi.lang}>{tytulDrugi.tekst}</p>}
    <div class="tags">
      <span class={`badge${d.rodzaj === 'ncn' ? ' badge-wydarzenie' : d.rodzaj === 'ue' ? ' badge-sukces' : ''}`}>{rodzaj}</span>
      {d.program && <span class="badge">{d.program}</span>}
      {d.rok_do !== undefined && <span class="badge">{trwa ? T('realizowany', 'ongoing') : T('zakończony', 'completed')}</span>}
    </div>
  </NaglowekStrony>
  <div class="wrap layout">
    <div class="main">
      <section class="grant-karta" aria-label={T('Informacje o projekcie', 'Project details')}>
        <dl class="info-list">
          <dt>{T('Finansowanie', 'Funding')}</dt><dd>{rodzaj}{d.program ? ` — ${d.program}` : ''}</dd>
          {d.kod && <><dt>{T('Numer', 'Number')}</dt><dd class="grant-kod">{d.kod}</dd></>}
          {okres && <><dt>{T('Realizacja', 'Duration')}</dt><dd>{okres}</dd></>}
          {d.kwota && <><dt>{T('Kwota', 'Budget')}</dt><dd>{d.kwota}</dd></>}
          {kierownicy.length > 0 && (
            <>
              <dt>{kierownicy.length > 1 ? T('Kierownicy', 'Principal investigators') : T('Kierownik', 'Principal investigator')}</dt>
              <dd>
                {kierownicy.map((k, i) => (
                  <>
                    {i > 0 && ', '}
                    {k.strona
                      ? <a href={k.strona}>{k.tekst}<Ikona nazwa="zewnetrzny" rozmiar={13} /></a>
                      : k.zaklad && wszystkieZaklady.some((z) => z.id === k.zaklad) ? <a href={adresZakladu(k.zaklad)}>{k.tekst}</a> : k.tekst}
                  </>
                ))}
              </dd>
            </>
          )}
          {d.wykonawcy && <><dt>{T('Wykonawcy', 'Team')}</dt><dd>{d.wykonawcy}</dd></>}
          {zaklad && <><dt>{T('Zakład', 'Department')}</dt><dd><a href={adresZakladu(zaklad.id)}>{wybierz(zaklad.data, 'nazwa', lang)}</a></dd></>}
        </dl>
        {d.strona && <p class="grant-akcje"><a class="btn btn-primary" href={d.strona}>{T('Strona projektu', 'Project website')}<Ikona nazwa="zewnetrzny" rozmiar={16} /></a></p>}
      </section>
      {maOpis && <div class="prose grant-opis"><Content /></div>}
    </div>
    <aside class="side" data-pagefind-ignore>
      {zaklad && (
        <div class="side-box">
          <h2>{T('Projekty zakładu', 'Department projects')}</h2>
          <a class="link-arrow" href={adresZakladu(zaklad.id)}>{wybierz(zaklad.data, 'nazwa', lang)}<Ikona nazwa="strzalka" rozmiar={16} /></a>
          {inne.length > 0 && (
            <ul class="plain-list grant-inne">
              {inne.slice(0, 5).map((g) => <li><a href={adresGrantu(g)}>{(lang === 'en' && g.data.tytul_en) || g.data.tytul}</a> <span class="muted">({lata(g)})</span></li>)}
            </ul>
          )}
          {inne.length > 5 && <a class="link-arrow" href={`${adresZakladu(zaklad.id)}#granty`}>{T(`Wszystkie projekty zakładu (${inne.length + 1})`, `All department projects (${inne.length + 1})`)}<Ikona nazwa="strzalka" rozmiar={16} /></a>}
        </div>
      )}
    </aside>
  </div>
</Baza>

<style>
  .grant-karta { padding: 20px 22px; border-radius: var(--radius-l); background: var(--surface); border: 1px solid var(--line); }
  .grant-karta .info-list dd { overflow-wrap: anywhere; }
  .grant-karta .info-list a { display: inline-flex; align-items: center; gap: 4px; }
  .grant-kod { font-variant-numeric: tabular-nums; }
  .grant-akcje { margin: 18px 0 0; }
  .grant-opis { margin-top: 28px; }
  .grant-inne { font-size: 15px; line-height: 1.45; }
  @media (max-width: 520px) {
    .grant-karta { padding: 16px; }
    .grant-karta .info-list { grid-template-columns: 1fr; gap: 0; }
    .grant-karta .info-list dd { margin-bottom: 10px; }
  }
</style>
