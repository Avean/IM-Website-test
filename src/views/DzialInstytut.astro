---
// Strona działu „Instytut” (/instytut, /en/instytut): wstęp, liczby, kafelki z menu „Instytut”,
// zakłady w skrócie, ostatnie sukcesy, kontakt. Teksty edytowalne w src/data/dzialy/instytut.json.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import dzial from '../data/dzialy/instytut.json';
import ustawienia from '../data/ustawienia.json';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, RODZAJE } from '../lib/i18n';
import { long, type Lang } from '../lib/daty';
import { menuGlowne } from '../lib/menu';
import { zTytulem } from '../lib/osoby';
import { zaklady, pracownicy, seminaria, aktualnosci, slugOf } from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));

// Odmiana po liczebniku: 1 / 2–4 (bez 12–14) / 5+ ; po angielsku: 1 / reszta.
const odm = (n: number, pl: [string, string, string], en: [string, string]) => {
  if (lang === 'en') return n === 1 ? en[0] : en[1];
  if (n === 1) return pl[0];
  const j = n % 10, d = n % 100;
  return j >= 2 && j <= 4 && (d < 12 || d > 14) ? pl[1] : pl[2];
};

const listaZakladow = await zaklady();
const osoby = await pracownicy();
const ileNauczycieli = osoby.filter((o) => o.data.grupa === 'nauczyciel').length;
const ileDoktorantow = osoby.filter((o) => o.data.grupa === 'doktorant').length;
const liczby = [
  { n: ileNauczycieli, l: odm(ileNauczycieli, ['nauczyciel akademicki', 'nauczycieli akademickich', 'nauczycieli akademickich'], ['academic staff member', 'academic staff']) },
  { n: ileDoktorantow, l: odm(ileDoktorantow, ['doktorant', 'doktorantów', 'doktorantów'], ['PhD student', 'PhD students']) },
  { n: listaZakladow.length, l: odm(listaZakladow.length, ['zakład lub pracownia', 'zakłady i pracownie', 'zakładów i pracowni'], ['department or unit', 'departments and units']) },
].filter((x) => x.n > 0);

// Kafelki: grupy i linki z menu „Instytut” (nowy link w menu sam pojawi się tutaj).
const pozycja = (await menuGlowne()).find((m) => m.etykieta === 'Instytut' || m.etykieta_en === 'Institute');
const grupy = (pozycja?.grupy ?? []).filter((g) => g.linki.length > 0);

// Kierownik zakładu z tytułem ze spisu pracowników (gdy jest), inaczej tak jak wpisano.
const kierownik = (imie?: string) => {
  if (!imie) return undefined;
  const o = osoby.find((p) => p.data.imie_nazwisko === imie);
  return o ? zTytulem(o.data.stopien, o.data.imie_nazwisko) : imie;
};

const sukcesy = (await aktualnosci()).filter((a) => a.data.rodzaj === 'sukces').slice(0, 3);

const k = ustawienia.kontakt;
const godziny = wybierz(dzial, 'kontakt_godziny', lang);
const mapa = k.adres ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Instytut Matematyczny Uniwersytetu Wrocławskiego, ${k.adres}`)}` : undefined;
// Mapa Google osadzana dopiero po kliknięciu (bez cookies Google do czasu zgody — patrz Polityka prywatności)
const mapaEmbed = k.adres ? `https://www.google.com/maps?q=${encodeURIComponent(`Instytut Matematyczny Uniwersytetu Wrocławskiego, ${k.adres}`)}&output=embed&hl=${lang}` : undefined;

const naglowek = T('Instytut', 'Institute');
const lead = wybierz(dzial, 'wstep', lang);
const zakladyOpis = wybierz(dzial, 'zaklady_opis', lang);
const sukcesyOpis = wybierz(dzial, 'sukcesy_opis', lang);
---
<Baza tytul={naglowek} opis={lead || undefined}>
  <NaglowekStrony tytul={naglowek} lead={lead || undefined} lang={lang} okruszki={[{ etykieta: naglowek }]}>
    {liczby.length > 0 && (
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
      </ul>
    )}
  </NaglowekStrony>
  {/* Wariant „Portal”: linki działu w kolumnach, zakłady w zwartej siatce, potem sukcesy | kontakt | mapa obok siebie. */}
  <div class="wrap" style="padding-top:4px;padding-bottom:36px">
    {grupy.length > 0 && (
      <section class="zsec" aria-labelledby="w-dziale">
        <h2 id="w-dziale">{T('W tym dziale', 'In this section')}</h2>
        <div class="pt-grid pt-rowne">
          {grupy.map((g) => (
            <div class="pt-box">
              <div class="pt-h"><h3>{wybierz(g, 'nazwa', lang)}</h3></div>
              <ul class="pt-links">
                {g.linki.map((l) => (
                  <li>
                    <a href={href(l.adres)}>
                      <span>{wybierz(l, 'etykieta', lang)}</span>
                      <Ikona nazwa={isExternal(l.adres) ? 'zewnetrzny' : 'strzalka'} rozmiar={16} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    {listaZakladow.length > 0 && (
      <section class="zsec" aria-labelledby="zaklady">
        <div class="dz-head">
          <h2 id="zaklady">{T('Zakłady', 'Departments')}</h2>
          <a class="pt-all" href={href('/instytut/struktura')}>{T('Struktura i zakłady', 'Structure and departments')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
        </div>
        {zakladyOpis && <p class="dz-intro">{zakladyOpis}</p>}
        <div class="pt-cards pt-cards-3">
          {listaZakladow.map((z) => {
            const obszary = lang === 'en' && z.data.obszary_en.length ? z.data.obszary_en : z.data.obszary;
            const kier = kierownik(z.data.kierownik);
            return (
              <article class="pt-card pt-link">
                <h3 class="n"><a href={href(`/instytut/zaklady/${z.id}`)}>{wybierz(z.data, 'nazwa', lang)}</a></h3>
                {obszary.length > 0 && <p class="pt-hasla">{obszary.slice(0, 4).map((o) => <span>{o}</span>)}</p>}
                {kier && <p class="f">{T('Kierownik', 'Head')}: <span class="dz-kier">{kier}</span></p>}
              </article>
            );
          })}
        </div>
      </section>
    )}

    <div class="zsec" style="margin-bottom:0">
      <div class="pt-grid">
        {sukcesy.length > 0 && (
          <section class="pt-box" aria-labelledby="sukcesy">
            <div class="pt-h">
              <h2 id="sukcesy">{T('Ostatnie sukcesy', 'Recent achievements')}</h2>
              <a class="pt-all" href={href('/nauka/sukcesy')}>{T('Wszystkie sukcesy', 'All achievements')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
            </div>
            {sukcesyOpis && <p class="pt-opis">{sukcesyOpis}</p>}
            <ul class="pt-list">
              {sukcesy.map((a) => {
                const zajawka = (lang === 'en' && a.data.zajawka_en) || a.data.zajawka;
                return (
                  <li>
                    <a class="pt-item" href={href(`/aktualnosci/${slugOf(a.id)}`)}>
                      <span class="pt-b">
                        <span class="pt-k"><time datetime={a.data.data.slice(0, 10)}>{long(a.data.data, lang, false)}</time></span>
                        <span class="pt-t">{(lang === 'en' && a.data.tytul_en) || a.data.tytul}</span>
                        {zajawka && <span class="pt-s">{zajawka}</span>}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        <section class="pt-box" aria-labelledby="kontakt">
          <div class="pt-h"><h2 id="kontakt">{T('Kontakt i dojazd', 'Contact and getting here')}</h2></div>
          <p class="dz-name">{t(lang, 'instytut')}, {t(lang, 'uwr')}</p>
          <ul class="dz-kontakt">
            {k.adres && <li><Ikona nazwa="pinezka" rozmiar={18} /><span>{k.adres}</span></li>}
            {k.telefon && <li><Ikona nazwa="telefon" rozmiar={18} /><a href={`tel:${k.telefon.replace(/\s/g, '')}`}>{k.telefon}</a></li>}
            {k.email && <li><Ikona nazwa="mail" rozmiar={18} /><a href={`mailto:${k.email}`}>{k.email}</a></li>}
            {godziny && <li><Ikona nazwa="zegar" rozmiar={18} /><span>{godziny}</span></li>}
          </ul>
          <p class="pt-stopka">
            <a class="pt-all" href={href('/instytut/kontakt')}>{T('Wszystkie dane kontaktowe', 'Full contact details')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
            {mapa && <a class="pt-all" href={mapa}>{T('Pokaż na mapie', 'Show on map')}<Ikona nazwa="zewnetrzny" rozmiar={14} /></a>}
          </p>
        </section>

        {mapaEmbed && (
          <div class="dz-mapa pt-szeroka-sr" data-mapa={mapaEmbed} data-tytul={T('Mapa: Instytut Matematyczny, pl. Grunwaldzki 2, Wrocław', 'Map: Mathematical Institute, pl. Grunwaldzki 2, Wrocław')}>
            <button type="button" class="dz-mapa-btn" data-mapa-pokaz>
              <Ikona nazwa="pinezka" rozmiar={28} />
              <span class="t">{T('Pokaż mapę Google', 'Show Google map')}</span>
              <span class="s">{T('Mapa załaduje się z serwisu Google Maps — Google może zapisać pliki cookies.', 'The map loads from Google Maps — Google may set cookies.')}</span>
            </button>
          </div>
        )}
      </div>
    </div>
  </div>
</Baza>

<style>
  .dz-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 20px; margin-bottom: 8px; }
  .dz-head h2 { margin: 0; font-size: 22px; font-weight: 800; scroll-margin-top: 16px; }
  .dz-intro { margin: -2px 0 10px; max-width: 860px; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .dz-kier { color: var(--text); font-weight: 600; }
  .dz-mapa { position: relative; align-self: stretch; min-height: 230px; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 32px 32px; }
  .dz-mapa :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .dz-mapa-btn { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 18px; border: 0; background: transparent; color: var(--ink); font: inherit; text-align: center; cursor: pointer; }
  .dz-mapa-btn :global(svg) { color: var(--primary); }
  :global(:root[data-theme='dark']) .dz-mapa-btn :global(svg) { color: var(--accent); }
  .dz-mapa-btn .t { padding: 9px 16px; border-radius: 999px; background: var(--bg); font-weight: 700; box-shadow: var(--shadow); }
  .dz-mapa-btn:hover .t { background: var(--primary); color: var(--primary-ink); }
  .dz-mapa-btn .s { max-width: 300px; font-size: 13px; color: var(--muted); }
  .dz-name { margin: 8px 0 6px; font-weight: 800; color: var(--ink); }
  .dz-kontakt { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; font-size: 15px; }
  .dz-kontakt li { display: flex; align-items: flex-start; gap: 10px; }
  .dz-kontakt li :global(svg) { flex: 0 0 auto; margin-top: 2px; color: var(--primary); }
  :global(:root[data-theme='dark']) .dz-kontakt li :global(svg) { color: var(--accent); }
  @media (max-width: 760px) { .dz-kontakt a { display: inline-flex; align-items: center; min-height: 40px; } .dz-kontakt li { align-items: center; } }
</style>

<script>
  // Mapa Google: ładowana dopiero po kliknięciu; wybór zapamiętany w tej przeglądarce
  const pokaz = (box: HTMLElement) => {
    const f = document.createElement('iframe');
    f.src = box.dataset.mapa || '';
    f.title = box.dataset.tytul || 'Mapa';
    f.loading = 'lazy';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    f.allowFullscreen = true;
    box.replaceChildren(f);
  };
  document.querySelectorAll<HTMLElement>('[data-mapa]').forEach((box) => {
    let zgoda = false;
    try { zgoda = localStorage.getItem('mapa-google') === '1'; } catch (e) {}
    if (zgoda) pokaz(box);
    box.querySelector('[data-mapa-pokaz]')?.addEventListener('click', () => {
      try { localStorage.setItem('mapa-google', '1'); } catch (e) {}
      pokaz(box);
    });
  });
</script>
