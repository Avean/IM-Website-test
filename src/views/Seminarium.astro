---
// Strona seminarium: informacje, nadchodzące i minione referaty ze streszczeniami.
import { render } from 'astro:content';
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import { u, isExternal, absolute } from '../lib/url';
import { t, wJezyku, RODZAJE } from '../lib/i18n';
import { longWithDay, short, time, now, today, hasTime, type Lang } from '../lib/daty';
import { referaty, seminariumReferatu, slugOf, sala, type Seminarium } from '../lib/tresci';
import { adresIcs } from '../lib/kalendarz';

interface Props { seminarium: Seminarium; lang: Lang }
const { seminarium, lang } = Astro.props;
const d = seminarium.data;
const nazwa = (lang === 'en' && d.nazwa_en) || d.nazwa;
const { Content } = await render(seminarium);
const wszystkie = (await referaty()).filter((r) => seminariumReferatu(r) === seminarium.id);
const n = now();
const przyszle = (r: (typeof wszystkie)[number]) => (hasTime(r.data.termin) ? r.data.termin >= n : r.data.termin >= today());
const nadchodzace = await Promise.all(wszystkie.filter(przyszle).map(async (r) => ({ r, C: (await render(r)).Content })));
const minione = await Promise.all(wszystkie.filter((r) => !przyszle(r)).reverse().map(async (r) => ({ r, C: (await render(r)).Content })));
const href = (a: string) => (isExternal(a) ? a : u(a));
const feed = adresIcs(`seminarium-${seminarium.id}`);
const webcal = absolute(feed, Astro.site).replace(/^https?:/, 'webcal:');
---
<Baza tytul={nazwa} opis={`${RODZAJE.referat[lang]}: ${nazwa}`} opublikowany={d.opublikowany}>
  <NaglowekStrony tytul={nazwa} lang={lang} okruszki={[{ etykieta: t(lang, 'seminaria'), adres: '/seminaria' }]} />
  <div class="wrap layout">
    <div class="main">
      <div class="prose"><Content /></div>

      <section aria-labelledby="h-nad" style="margin-top:24px">
        <h2 id="h-nad" style="font-size:26px;margin:0 0 4px">{t(lang, 'nadchodzace')}</h2>
        {nadchodzace.length === 0 && <p class="muted">{t(lang, 'brakNadchodzacych')}</p>}
        {nadchodzace.map(({ r, C }) => (
          <article class="talk" id={slugOf(r.id)}>
            <div class="talk-meta">
              <strong style="color:var(--ink)">{longWithDay(r.data.termin, lang)}</strong>
              {r.data.sala && <span>· {sala(r.data.sala, lang)}</span>}
            </div>
            <h3>{r.data.tytul}</h3>
            <div class="who">{r.data.prelegent}{r.data.afiliacja && <span class="muted"> ({r.data.afiliacja})</span>}</div>
            {r.body?.trim() && <div class="prose" style="font-size:16px;margin-top:10px"><C /></div>}
            {r.data.pliki.length > 0 && (
              <ul class="files" style="margin-top:10px">{r.data.pliki.map((p) => <li><a href={href(p.plik)}><Ikona nazwa="plik" />{p.nazwa || p.plik.split('/').pop()}</a></li>)}</ul>
            )}
          </article>
        ))}
      </section>

      {minione.length > 0 && (
        <section aria-labelledby="h-min" style="margin-top:36px">
          <h2 id="h-min" style="font-size:22px;margin:0 0 4px">{t(lang, 'minione')}</h2>
          {minione.map(({ r, C }) => (
            <article class="talk" id={slugOf(r.id)}>
              <div class="talk-meta"><span>{short(r.data.termin)}{hasTime(r.data.termin) ? `, ${time(r.data.termin)}` : ''}</span>{r.data.sala && <span>· {sala(r.data.sala, lang)}</span>}</div>
              <h3 style="font-size:17px">{r.data.tytul}</h3>
              <div class="who">{r.data.prelegent}{r.data.afiliacja && <span class="muted"> ({r.data.afiliacja})</span>}</div>
              {r.body?.trim() && (
                <details>
                  <summary>{t(lang, 'streszczenie')}</summary>
                  <div class="prose" style="font-size:16px;margin-top:8px"><C /></div>
                </details>
              )}
              {r.data.pliki.length > 0 && (
                <ul class="files" style="margin-top:10px">{r.data.pliki.map((p) => <li><a href={href(p.plik)}><Ikona nazwa="plik" />{p.nazwa || p.plik.split('/').pop()}</a></li>)}</ul>
              )}
            </article>
          ))}
        </section>
      )}
      {d.archiwum && <p style="margin-top:28px"><a class="link-arrow" href={d.archiwum}>{t(lang, 'archiwumSem')}<Ikona nazwa="zewnetrzny" rozmiar={14} /></a></p>}
    </div>

    <aside class="side">
      <div class="side-box">
        <dl class="info-list">
          {d.termin && <><dt>{t(lang, 'termin')}</dt><dd>{d.termin}</dd></>}
          {d.prowadzacy.length > 0 && <><dt>{t(lang, 'prowadzacy')}</dt><dd>{d.prowadzacy.join(', ')}</dd></>}
          {d.kontakt && <><dt>{t(lang, 'kontaktowy')}</dt><dd><a href={`mailto:${d.kontakt}`}>{d.kontakt}</a></dd></>}
        </dl>
        {d.strona && <a class="link-arrow" href={d.strona}>{t(lang, 'stronaSeminarium')}<Ikona nazwa="zewnetrzny" rozmiar={14} /></a>}
        {d.grupa_google && <a class="btn btn-primary" href={d.grupa_google}><Ikona nazwa="mail" rozmiar={16} />{t(lang, 'zapiszSie')}</a>}
      </div>
      <div class="side-box">
        <h2>{t(lang, 'subskrypcja')}</h2>
        <div style="display:flex;flex-wrap:wrap;gap:6px">
          <button type="button" class="btn btn-small" data-kopiuj={absolute(feed, Astro.site)} data-ok={t(lang, 'skopiowano')}><Ikona nazwa="link" rozmiar={15} /><span>{t(lang, 'kopiuj')}</span></button>
          <a class="btn btn-small" href={`https://calendar.google.com/calendar/render?cid=${encodeURIComponent(webcal)}`}>Google</a>
          <a class="btn btn-small" href={webcal}>Apple / Outlook</a>
        </div>
      </div>
      <a class="link-arrow" href={u(wJezyku('/seminaria', lang))}><Ikona nazwa="wstecz" rozmiar={16} />{t(lang, 'wszystkieSeminaria')}</a>
    </aside>
  </div>
</Baza>
