---
// Strona działu „Nauka” (/nauka, /en/nauka): wstęp, liczby, kafelki z menu „Nauka”, obszary badań zakładów,
// seminaria w tym tygodniu, konferencje, realizowane projekty i obrony doktorskie.
// Teksty edytowalne w CMS: src/data/dzialy/nauka.json — reszta wylicza się sama z kolekcji treści.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import TabelaReferatow from '../components/TabelaReferatow.astro';
import WartoWiedziec from '../components/WartoWiedziec.astro';
import dzial from '../data/dzialy/nauka.json';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, RODZAJE_GRANTOW } from '../lib/i18n';
import { today, addDays, range, dayNum, monthShort, longWithDay, type Lang } from '../lib/daty';
import { menuGlowne } from '../lib/menu';
import {
  zaklady, seminaria, konferencje, granty, obrony, referatyWTygodniu, tydzienSeminariow, trwaLubBedzie, slugOf,
  type Grant, type Konferencja, type Obrona, type Zaklad,
} from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));

// Odmiana po liczebniku: 1 / 2–4 (bez 12–14) / 5+ ; po angielsku: 1 / reszta.
const odm = (n: number, pl: [string, string, string], en: [string, string]) => {
  if (lang === 'en') return n === 1 ? en[0] : en[1];
  if (n === 1) return pl[0];
  const j = n % 10, d = n % 100;
  return j >= 2 && j <= 4 && (d < 12 || d > 14) ? pl[1] : pl[2];
};

const [listaZakladow, listaSeminariow, listaKonferencji, listaGrantow, listaObron] = await Promise.all([
  zaklady(), seminaria(), konferencje(), granty(), obrony(),
]);
const dzis = today();
const rok = Number(dzis.slice(0, 4));

// Projekty realizowane — tak samo jak na /nauka/granty: rok zakończenia ≥ bieżący rok.
const realizowane = listaGrantow.filter((g) => (g.data.rok_do ?? 0) >= rok);
const maOpis = (g: Grant) => !!g.body?.trim();
// Przykłady: najpierw projekty z opisem, potem najnowsze (każdy ma własną podstronę).
const przyklady = [...realizowane.filter(maOpis), ...realizowane.filter((g) => !maOpis(g))].slice(0, 4);
const lata = (g: Grant) => (g.data.rok_od && g.data.rok_do && g.data.rok_od !== g.data.rok_do ? `${g.data.rok_od}–${g.data.rok_do}` : String(g.data.rok_od ?? g.data.rok_do ?? ''));
const tytulGrantu = (g: Grant) => (lang === 'en' && g.data.tytul_en) || g.data.tytul;

const aktywneSeminaria = listaSeminariow.filter((s) => s.data.aktywne !== false);
const referaty = await referatyWTygodniu(lang);
const tydzien = tydzienSeminariow();
const naglowekSeminariow = t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien');

// Konferencje: nadchodzące i trwające (najbliższe najpierw); gdy brak — trzy ostatnie.
const konfTrwa = (k: Konferencja) => trwaLubBedzie({ poczatek: k.data.poczatek, koniec: k.data.koniec });
const nadchodzaceKonf = listaKonferencji.filter(konfTrwa).reverse().slice(0, 3);
const pokazKonf = nadchodzaceKonf.length ? nadchodzaceKonf : listaKonferencji.filter((k) => !konfTrwa(k)).slice(0, 3);
const konfWRoku = listaKonferencji.filter((k) => k.data.poczatek.slice(0, 4) === String(rok) && !k.data.odwolana);

// Obrony: najbliższe, a po nich ostatnio odbyte — razem trzy.
const obronaBedzie = (o: Obrona) => trwaLubBedzie({ poczatek: o.data.termin });
const odbyteObrony = listaObron.filter((o) => !obronaBedzie(o));
const pokazObrony = [...listaObron.filter(obronaBedzie).reverse(), ...odbyteObrony].slice(0, 3);
const rokTemu = addDays(dzis, -365);
const obronyRok = odbyteObrony.filter((o) => o.data.termin.slice(0, 10) >= rokTemu);

// Pasek liczb (pozycje z zerem pomijamy).
const liczby = [
  { n: realizowane.length, l: odm(realizowane.length, ['realizowany projekt badawczy', 'realizowane projekty badawcze', 'realizowanych projektów badawczych'], ['ongoing research project', 'ongoing research projects']) },
  { n: aktywneSeminaria.length, l: odm(aktywneSeminaria.length, ['aktywne seminarium', 'aktywne seminaria', 'aktywnych seminariów'], ['active seminar', 'active seminars']) },
  { n: konfWRoku.length, l: `${odm(konfWRoku.length, ['konferencja', 'konferencje', 'konferencji'], ['conference', 'conferences'])} ${T(`w ${rok} roku`, `in ${rok}`)}` },
  { n: obronyRok.length, l: `${odm(obronyRok.length, ['obrona doktorska', 'obrony doktorskie', 'obron doktorskich'], ['PhD defence', 'PhD defences'])} ${T('w ostatnich 12 miesiącach', 'in the last 12 months')}` },
].filter((x) => x.n > 0);

// Kafelki: grupy i linki z menu „Nauka” (nowy link w menu sam pojawi się tutaj).
const pozycja = (await menuGlowne()).find((m) => m.etykieta === 'Nauka' || m.etykieta_en === 'Research');
const grupy = (pozycja?.grupy ?? []).filter((g) => g.linki.length > 0);

const nazwaKrotka = (z: Zaklad) =>
  lang === 'en' ? z.data.nazwa_krotka_en || z.data.nazwa_en || z.data.nazwa_krotka || z.data.nazwa : z.data.nazwa_krotka || z.data.nazwa;
const obszaryZakladu = (z: Zaklad) => (lang === 'en' && z.data.obszary_en.length ? z.data.obszary_en : z.data.obszary);

const naglowek = T('Nauka', 'Research');
const lead = wybierz(dzial, 'wstep', lang);
const obszaryOpis = wybierz(dzial, 'obszary_opis', lang);
---
<Baza tytul={naglowek} opis={lead || undefined}>
  <NaglowekStrony tytul={naglowek} lead={lead || undefined} lang={lang} okruszki={[{ etykieta: naglowek }]}>
    {liczby.length > 0 && (
      <ul class="pt-liczby">
        {liczby.map((x) => <li><span class="n">{x.n}</span>{x.l}</li>)}
      </ul>
    )}
  </NaglowekStrony>
  {/* Wariant „Portal”: linki działu w kolumnach, potem „co się dzieje” (seminaria | konferencje | obrony) w trzech kolumnach,
       zakłady w zwartej siatce, na końcu projekty i „Warto wiedzieć” obok siebie. */}
  <div class="wrap" style="padding-top:4px;padding-bottom:36px">
    {grupy.length > 0 && (
      <section class="zsec" aria-labelledby="w-dziale">
        <h2 id="w-dziale">{T('W tym dziale', 'In this section')}</h2>
        <div class="pt-grid pt-rowne">
          {grupy.map((g) => (
            <div class="pt-box">
              <div class="pt-h"><h3>{wybierz(g, 'nazwa', lang)}</h3></div>
              <ul class="pt-links">
                {g.linki.map((l) => (
                  <li>
                    <a href={href(l.adres)}>
                      <span>{wybierz(l, 'etykieta', lang)}</span>
                      <Ikona nazwa={isExternal(l.adres) ? 'zewnetrzny' : 'strzalka'} rozmiar={16} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="zsec">
      <div class="pt-grid">
        <section class="pt-box" aria-labelledby="seminaria">
          <div class="pt-h">
            <span class="pt-h-l">
              <h2 id="seminaria">{naglowekSeminariow}</h2>
              <span class="pt-zakres">{range(tydzien.od, tydzien.do, lang)}</span>
            </span>
          </div>
          <TabelaReferatow
            lista
            wiersze={referaty}
            lang={lang}
            etykieta={naglowekSeminariow}
            pusty={t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')}
          />
          <p class="pt-stopka"><a class="pt-all" href={href('/seminaria')}>{t(lang, 'wszystkieSeminaria')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
        </section>

        <section class="pt-box" aria-labelledby="konferencje">
          <div class="pt-h"><h2 id="konferencje">{nadchodzaceKonf.length ? T('Najbliższe konferencje', 'Upcoming conferences') : T('Konferencje', 'Conferences')}</h2></div>
          {nadchodzaceKonf.length === 0 && (
            <p class="pt-opis">
              {T('Nie zapowiedziano jeszcze kolejnych konferencji.', 'No upcoming conferences have been announced yet.')}
              {pokazKonf.length > 0 && ` ${T('Ostatnio odbyły się:', 'Most recent:')}`}
            </p>
          )}
          {pokazKonf.length > 0 && (
            <ul class="pt-list">
              {pokazKonf.map((k) => (
                <li>
                  <a class="pt-item" href={href(`/nauka/konferencje/${slugOf(k.id)}`)}>
                    <span class={`pt-dbox${nadchodzaceKonf.length ? '' : ' light'}`} aria-hidden="true"><span class="d">{dayNum(k.data.poczatek)}</span><span class="m">{monthShort(k.data.poczatek, lang)}</span></span>
                    <span class="pt-b">
                      <span class="pt-k">{range(k.data.poczatek, k.data.koniec, lang)}</span>
                      <span class="pt-t">{wybierz(k.data, 'tytul', lang)}</span>
                      {k.data.miejsce && <span class="pt-s">{k.data.miejsce}</span>}
                      {k.data.odwolana && <span><span class="badge">{T('odwołana', 'cancelled')}</span></span>}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          <p class="pt-stopka"><a class="pt-all" href={href('/nauka/konferencje')}>{T('Wszystkie konferencje', 'All conferences')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
        </section>

        <section class="pt-box pt-szeroka-sr" aria-labelledby="obrony">
          <div class="pt-h"><h2 id="obrony">{t(lang, 'obrony')}</h2></div>
          {pokazObrony.length === 0 && <p class="pt-pusto">{T('Brak zapowiedzianych obron.', 'No PhD defences announced.')}</p>}
          {pokazObrony.length > 0 && (
            <ul class="pt-list">
              {pokazObrony.map((o) => {
                const bedzie = obronaBedzie(o);
                return (
                  <li>
                    <a class="pt-item" href={href(`/obrony-doktorskie/${slugOf(o.id)}`)}>
                      <span class={`pt-dbox${bedzie ? '' : ' light'}`} aria-hidden="true"><span class="d">{dayNum(o.data.termin)}</span><span class="m">{monthShort(o.data.termin, lang)}</span></span>
                      <span class="pt-b">
                        <span class="pt-k">{bedzie && <>{T('nadchodząca', 'upcoming')} · </>}<span class="pt-k-m">{longWithDay(o.data.termin, lang)}</span></span>
                        <span class="pt-t">{o.data.kandydat}</span>
                        <span class="pt-s" lang="en">{o.data.tytul_rozprawy}</span>
                        {o.data.miejsce && <span class="pt-s">{o.data.miejsce}</span>}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
          <p class="pt-stopka"><a class="pt-all" href={href('/obrony-doktorskie')}>{T('Wszystkie obrony', 'All PhD defences')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
        </section>
      </div>
    </div>

    {listaZakladow.length > 0 && (
      <section class="zsec" aria-labelledby="obszary">
        <div class="dz-head">
          <h2 id="obszary">{T('Obszary badań', 'Research areas')}</h2>
          <a class="pt-all" href={href('/instytut/struktura')}>{T('Struktura i zakłady', 'Structure and departments')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
        </div>
        {obszaryOpis && <p class="dz-intro">{obszaryOpis}</p>}
        <div class="pt-cards pt-cards-3">
          {listaZakladow.map((z) => (
            <article class="pt-card pt-link">
              <h3 class="n"><a href={href(`/instytut/zaklady/${z.id}`)}>{nazwaKrotka(z)}</a></h3>
              {obszaryZakladu(z).length > 0 && <p class="pt-hasla">{obszaryZakladu(z).map((o) => <span>{o}</span>)}</p>}
              <p class="f">{wybierz(z.data, 'nazwa', lang)}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="zsec" style="margin-bottom:0">
      <div class="pt-grid">
        <section class="pt-box pt-span-2" aria-labelledby="granty">
          <div class="pt-h">
            <span class="pt-h-l">
              <h2 id="granty">{T('Realizowane projekty', 'Ongoing projects')}</h2>
              <span class="pt-zakres">({realizowane.length})</span>
            </span>
            <a class="pt-all" href={href('/nauka/granty')}>{T('Wszystkie projekty i granty', 'All projects and grants')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
          </div>
          {realizowane.length === 0 && <p class="pt-pusto">{T('Obecnie brak realizowanych projektów.', 'No ongoing projects at the moment.')}</p>}
          {realizowane.length > przyklady.length && <p class="pt-opis">{T(`Wybrane spośród ${realizowane.length} realizowanych projektów.`, `A selection of ${realizowane.length} ongoing projects.`)}</p>}
          {przyklady.length > 0 && (
            <div class="pt-cards pt-cards-2 dz-granty">
              {przyklady.map((g) => (
                <article class="pt-card pt-link">
                  <div class="news-meta">
                    <span class={`badge${g.data.rodzaj === 'ncn' ? ' badge-wydarzenie' : g.data.rodzaj === 'ue' ? ' badge-sukces' : ''}`}>{RODZAJE_GRANTOW[g.data.rodzaj][lang]}</span>
                    {g.data.program && <span class="badge">{g.data.program}</span>}
                    {lata(g) && <span>{lata(g)}</span>}
                  </div>
                  <h3 class="n"><a href={href(`/nauka/granty/${slugOf(g.id)}`)}>{tytulGrantu(g)}</a></h3>
                  {g.data.kierownik && <p class="o"><span class="muted">{T('Kierownik', 'Principal investigator')}:</span> {g.data.kierownik}</p>}
                  {(g.data.kod || g.data.strona) && (
                    <p class="f">
                      {g.data.kod && <span class="dz-kod">{g.data.kod}</span>}
                      {g.data.strona && <a href={g.data.strona}>{T('Strona projektu', 'Project website')} <Ikona nazwa="zewnetrzny" rozmiar={13} /></a>}
                    </p>
                  )}
                </article>
              ))}
            </div>
          )}
        </section>
        <div class="pt-col pt-szeroka-sr">
          <WartoWiedziec lang={lang} dzial="nauka" uklad="portal" />
        </div>
      </div>
    </div>
  </div>
</Baza>

<style>
  .dz-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 20px; margin-bottom: 8px; }
  .dz-head h2 { margin: 0; font-size: 22px; font-weight: 800; scroll-margin-top: 16px; }
  .dz-intro { margin: -2px 0 10px; max-width: 860px; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .dz-granty { margin-top: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 560px) { .dz-granty { grid-template-columns: minmax(0, 1fr); } }
  .dz-granty .news-meta { font-size: 13px; gap: 4px 8px; }
  .dz-granty .f { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; }
  .dz-kod { font-variant-numeric: tabular-nums; }
</style>
