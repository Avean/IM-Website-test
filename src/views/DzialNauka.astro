---
// Strona działu „Nauka” (/nauka, /en/nauka): wstęp, liczby, kafelki z menu „Nauka”, obszary badań zakładów,
// seminaria w tym tygodniu, konferencje, realizowane projekty i obrony doktorskie.
// Teksty edytowalne w CMS: src/data/dzialy/nauka.json — reszta wylicza się sama z kolekcji treści.
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import Ikona from '../components/Ikona.astro';
import TabelaReferatow from '../components/TabelaReferatow.astro';
import WartoWiedziec from '../components/WartoWiedziec.astro';
import dzial from '../data/dzialy/nauka.json';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, RODZAJE_GRANTOW } from '../lib/i18n';
import { today, addDays, range, dayNum, monthShort, longWithDay, type Lang } from '../lib/daty';
import { menuGlowne } from '../lib/menu';
import {
  zaklady, seminaria, konferencje, granty, obrony, referatyWTygodniu, tydzienSeminariow, trwaLubBedzie, slugOf,
  type Grant, type Konferencja, type Obrona, type Zaklad,
} from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (pl: string, en: string) => (lang === 'en' ? en : pl);
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));

// Odmiana po liczebniku: 1 / 2–4 (bez 12–14) / 5+ ; po angielsku: 1 / reszta.
const odm = (n: number, pl: [string, string, string], en: [string, string]) => {
  if (lang === 'en') return n === 1 ? en[0] : en[1];
  if (n === 1) return pl[0];
  const j = n % 10, d = n % 100;
  return j >= 2 && j <= 4 && (d < 12 || d > 14) ? pl[1] : pl[2];
};

const [listaZakladow, listaSeminariow, listaKonferencji, listaGrantow, listaObron] = await Promise.all([
  zaklady(), seminaria(), konferencje(), granty(), obrony(),
]);
const dzis = today();
const rok = Number(dzis.slice(0, 4));

// Projekty realizowane — tak samo jak na /nauka/granty: rok zakończenia ≥ bieżący rok.
const realizowane = listaGrantow.filter((g) => (g.data.rok_do ?? 0) >= rok);
const maOpis = (g: Grant) => !!g.body?.trim();
// Przykłady: najpierw projekty z opisem, potem najnowsze (każdy ma własną podstronę).
// (wariant redakcyjny: wiersze tabeli zamiast kart — mieści się sześć)
const przyklady = [...realizowane.filter(maOpis), ...realizowane.filter((g) => !maOpis(g))].slice(0, 6);
const lata = (g: Grant) => (g.data.rok_od && g.data.rok_do && g.data.rok_od !== g.data.rok_do ? `${g.data.rok_od}–${g.data.rok_do}` : String(g.data.rok_od ?? g.data.rok_do ?? ''));
const tytulGrantu = (g: Grant) => (lang === 'en' && g.data.tytul_en) || g.data.tytul;

const aktywneSeminaria = listaSeminariow.filter((s) => s.data.aktywne !== false);
const referaty = await referatyWTygodniu(lang);
const tydzien = tydzienSeminariow();
const naglowekSeminariow = t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien');

// Konferencje: nadchodzące i trwające (najbliższe najpierw); gdy brak — trzy ostatnie.
const konfTrwa = (k: Konferencja) => trwaLubBedzie({ poczatek: k.data.poczatek, koniec: k.data.koniec });
const nadchodzaceKonf = listaKonferencji.filter(konfTrwa).reverse().slice(0, 3);
const pokazKonf = nadchodzaceKonf.length ? nadchodzaceKonf : listaKonferencji.filter((k) => !konfTrwa(k)).slice(0, 3);
const konfWRoku = listaKonferencji.filter((k) => k.data.poczatek.slice(0, 4) === String(rok) && !k.data.odwolana);

// Obrony: najbliższe, a po nich ostatnio odbyte — razem trzy.
const obronaBedzie = (o: Obrona) => trwaLubBedzie({ poczatek: o.data.termin });
const odbyteObrony = listaObron.filter((o) => !obronaBedzie(o));
const pokazObrony = [...listaObron.filter(obronaBedzie).reverse(), ...odbyteObrony].slice(0, 3);
const rokTemu = addDays(dzis, -365);
const obronyRok = odbyteObrony.filter((o) => o.data.termin.slice(0, 10) >= rokTemu);

// Pasek liczb (pozycje z zerem pomijamy).
const liczby = [
  { n: realizowane.length, l: odm(realizowane.length, ['realizowany projekt badawczy', 'realizowane projekty badawcze', 'realizowanych projektów badawczych'], ['ongoing research project', 'ongoing research projects']) },
  { n: aktywneSeminaria.length, l: odm(aktywneSeminaria.length, ['aktywne seminarium', 'aktywne seminaria', 'aktywnych seminariów'], ['active seminar', 'active seminars']) },
  { n: konfWRoku.length, l: `${odm(konfWRoku.length, ['konferencja', 'konferencje', 'konferencji'], ['conference', 'conferences'])} ${T(`w ${rok} roku`, `in ${rok}`)}` },
  { n: obronyRok.length, l: `${odm(obronyRok.length, ['obrona doktorska', 'obrony doktorskie', 'obron doktorskich'], ['PhD defence', 'PhD defences'])} ${T('w ostatnich 12 miesiącach', 'in the last 12 months')}` },
].filter((x) => x.n > 0);

// Kafelki: grupy i linki z menu „Nauka” (nowy link w menu sam pojawi się tutaj).
const pozycja = (await menuGlowne()).find((m) => m.etykieta === 'Nauka' || m.etykieta_en === 'Research');
const grupy = (pozycja?.grupy ?? []).filter((g) => g.linki.length > 0);

const nazwaKrotka = (z: Zaklad) =>
  lang === 'en' ? z.data.nazwa_krotka_en || z.data.nazwa_en || z.data.nazwa_krotka || z.data.nazwa : z.data.nazwa_krotka || z.data.nazwa;
const obszaryZakladu = (z: Zaklad) => (lang === 'en' && z.data.obszary_en.length ? z.data.obszary_en : z.data.obszary);

const naglowek = T('Nauka', 'Research');
const lead = wybierz(dzial, 'wstep', lang);
const obszaryOpis = wybierz(dzial, 'obszary_opis', lang);
---
<Baza tytul={naglowek} opis={lead || undefined}>
  <NaglowekStrony tytul={naglowek} lead={lead || undefined} lang={lang} okruszki={[{ etykieta: naglowek }]} />
  <div class="wrap dz-wrap">
    {liczby.length > 0 && (
      <div class="stats">
        {liczby.map((x) => <div class="stat"><span class="n">{x.n}</span><span class="l">{x.l}</span></div>)}
      </div>
    )}

    {/* Wariant redakcyjny: każda sekcja w dwóch kolumnach — nagłówek po lewej (.k2-h), treść po prawej (.k2-b). */}
    {grupy.length > 0 && (
      <section class="zsec k2" aria-labelledby="w-dziale">
        <div class="k2-h"><h2 id="w-dziale">{T('W tym dziale', 'In this section')}</h2></div>
        <div class="k2-b dz-groups">
          {grupy.map((g) => (
            <div class="dz-g">
              <h3>{wybierz(g, 'nazwa', lang)}</h3>
              <ul class="dz-linki">
                {g.linki.map((l) => (
                  <li><a href={href(l.adres)}><span>{wybierz(l, 'etykieta', lang)}</span><Ikona nazwa={isExternal(l.adres) ? 'zewnetrzny' : 'strzalka'} rozmiar={15} /></a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    {listaZakladow.length > 0 && (
      <section class="zsec k2" aria-labelledby="obszary">
        <div class="k2-h">
          <h2 id="obszary">{T('Obszary badań', 'Research areas')}</h2>
          <a class="link-arrow" href={href('/instytut/struktura')}>{T('Struktura i zakłady', 'Structure and departments')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
          {obszaryOpis && <p>{obszaryOpis}</p>}
        </div>
        <div class="k2-b spec-grid">
          {listaZakladow.map((z) => (
            <article class="spec spec-link">
              <h3><a href={href(`/instytut/zaklady/${z.id}`)}>{nazwaKrotka(z)}</a></h3>
              {obszaryZakladu(z).length > 0 && <p class="dz-tags">{obszaryZakladu(z).map((o) => <span class="badge">{o}</span>)}</p>}
              <p class="foot"><span class="muted">{wybierz(z.data, 'nazwa', lang)}</span></p>
            </article>
          ))}
        </div>
      </section>
    )}

    <WartoWiedziec lang={lang} dzial="nauka" />

    <section class="zsec k2" aria-labelledby="seminaria">
      <div class="k2-h">
        <h2 id="seminaria">{naglowekSeminariow}</h2>
        <a class="link-arrow" href={href('/seminaria')}>{t(lang, 'wszystkieSeminaria')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
        <p>{range(tydzien.od, tydzien.do, lang)}</p>
      </div>
      <div class="k2-b">
        <TabelaReferatow
          wiersze={referaty}
          lang={lang}
          etykieta={naglowekSeminariow}
          pusty={t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')}
        />
      </div>
    </section>

    <section class="zsec k2" aria-labelledby="konferencje">
      <div class="k2-h">
        <h2 id="konferencje">{nadchodzaceKonf.length ? T('Najbliższe konferencje', 'Upcoming conferences') : T('Konferencje', 'Conferences')}</h2>
        <a class="link-arrow" href={href('/nauka/konferencje')}>{T('Wszystkie konferencje', 'All conferences')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
      </div>
      <div class="k2-b">
        {nadchodzaceKonf.length === 0 && (
          <p class="k2-uwaga">
            {T('Nie zapowiedziano jeszcze kolejnych konferencji.', 'No upcoming conferences have been announced yet.')}
            {pokazKonf.length > 0 && ` ${T('Ostatnio odbyły się:', 'Most recent:')}`}
          </p>
        )}
        {pokazKonf.length > 0 && (
          <div class="event-grid dz-konf">
            {pokazKonf.map((k) => (
              <a class="event" href={href(`/nauka/konferencje/${slugOf(k.id)}`)}>
                <span class={`datebox${nadchodzaceKonf.length ? '' : ' light'}`} aria-hidden="true"><span class="d">{dayNum(k.data.poczatek)}</span><span class="m">{monthShort(k.data.poczatek, lang)}</span></span>
                <span class="event-body">
                  <span class="k">{range(k.data.poczatek, k.data.koniec, lang)}</span>
                  <span class="t">{wybierz(k.data, 'tytul', lang)}</span>
                  {k.data.miejsce && <span class="s">{k.data.miejsce}</span>}
                  {k.data.odwolana && <span><span class="badge">{T('odwołana', 'cancelled')}</span></span>}
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="zsec k2" aria-labelledby="granty">
      <div class="k2-h">
        <h2 id="granty">{T('Realizowane projekty', 'Ongoing projects')} <span class="k2-ile">({realizowane.length})</span></h2>
        <a class="link-arrow" href={href('/nauka/granty')}>{T('Wszystkie projekty i granty', 'All projects and grants')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
        {realizowane.length > przyklady.length && <p>{T(`Wybrane spośród ${realizowane.length} realizowanych projektów.`, `A selection of ${realizowane.length} ongoing projects.`)}</p>}
      </div>
      <div class="k2-b">
        {realizowane.length === 0 && <p class="k2-uwaga">{T('Obecnie brak realizowanych projektów.', 'No ongoing projects at the moment.')}</p>}
        {przyklady.length > 0 && (
          <div class="dz-lista">
            {przyklady.map((g) => (
              <article class="dz-grant">
                <span class="dz-lata">{lata(g)}</span>
                <div class="dz-gb">
                  <h3><a href={href(`/nauka/granty/${slugOf(g.id)}`)}>{tytulGrantu(g)}</a></h3>
                  {g.data.kierownik && <p><span class="muted">{T('Kierownik', 'Principal investigator')}:</span> {g.data.kierownik}</p>}
                </div>
                <div class="dz-gm">
                  <span class="dz-rodzaj">{RODZAJE_GRANTOW[g.data.rodzaj][lang]}{g.data.program && ` · ${g.data.program}`}</span>
                  {g.data.kod && <span class="dz-kod">{g.data.kod}</span>}
                  {g.data.strona && <a href={g.data.strona}>{T('Strona projektu', 'Project website')} <Ikona nazwa="zewnetrzny" rozmiar={13} /></a>}
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="zsec k2" aria-labelledby="obrony" style="margin-bottom:0">
      <div class="k2-h">
        <h2 id="obrony">{t(lang, 'obrony')}</h2>
        <a class="link-arrow" href={href('/obrony-doktorskie')}>{T('Wszystkie obrony', 'All PhD defences')}<Ikona nazwa="strzalka" rozmiar={16} /></a>
      </div>
      <div class="k2-b">
        {pokazObrony.length === 0 && <p class="k2-uwaga">{T('Brak zapowiedzianych obron.', 'No PhD defences announced.')}</p>}
        {pokazObrony.length > 0 && (
          <div class="dz-lista dz-obrony">
            {pokazObrony.map((o) => {
              const bedzie = obronaBedzie(o);
              return (
                <a class="row-item" href={href(`/obrony-doktorskie/${slugOf(o.id)}`)}>
                  <span class={`datebox small${bedzie ? '' : ' light'}`} aria-hidden="true"><span class="d">{dayNum(o.data.termin)}</span><span class="m">{monthShort(o.data.termin, lang)}</span></span>
                  <span class="body">
                    <span class="news-meta">
                      {bedzie && <span class="badge badge-obrona">{T('nadchodząca', 'upcoming')}</span>}
                      <span>{longWithDay(o.data.termin, lang)}</span>
                      {o.data.miejsce && <span>· {o.data.miejsce}</span>}
                    </span>
                    <span class="t">{o.data.kandydat}</span>
                    <span class="x" lang="en">{o.data.tytul_rozprawy}</span>
                  </span>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>
  </div>
</Baza>

<style>
  /* Realizowane projekty jako wiersze: lata | tytuł i kierownik | rodzaj, kod, strona */
  .dz-grant { position: relative; display: grid; grid-template-columns: 6.5em minmax(0, 1fr) minmax(0, 13em); gap: 2px 20px; align-items: baseline; padding: 9px 0 10px; border-bottom: 1px solid var(--line); }
  .dz-lata { font-size: 14px; font-weight: 700; color: var(--muted); font-variant-numeric: tabular-nums; }
  .dz-gb h3 { margin: 0; font-size: 16px; font-weight: 800; line-height: 1.3; }
  .dz-gb h3 a { color: var(--ink); text-decoration: none; }
  .dz-gb h3 a::after { content: ''; position: absolute; inset: 0; }
  .dz-grant:hover h3 a { text-decoration: underline; text-underline-offset: 3px; }
  .dz-gb p { margin: 1px 0 0; font-size: 14px; }
  .dz-gm { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; font-size: 13.5px; text-align: right; }
  .dz-gm a { position: relative; z-index: 1; }
  .dz-rodzaj { font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .dz-kod { color: var(--muted); font-variant-numeric: tabular-nums; }
  .dz-obrony { border-bottom: 1px solid var(--line); }
  .dz-obrony .row-item:first-child { border-top: 0; }
  @media (max-width: 640px) {
    .dz-grant { grid-template-columns: minmax(0, 1fr); }
    .dz-gm { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; text-align: left; }
  }
</style>
