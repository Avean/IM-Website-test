---
// Zwarta lista referatów (strona główna: „Seminaria w tym tygodniu”).
// lista = wariant „Portal”: pozycje jedna pod drugą (dzień i godzina z lewej, seminarium, tytuł i prelegent obok) — do wąskiej kolumny.
import { u } from '../lib/url';
import { wJezyku } from '../lib/i18n';
import { dayShort, short, time, type Lang } from '../lib/daty';
import { sala } from '../lib/tresci';

interface Wiersz { termin: string; sala?: string; seminarium: string; tytul: string; prelegent: string; href: string }
interface Props { wiersze: Wiersz[]; lang: Lang; pusty: string; etykieta: string; lista?: boolean }
const { wiersze, lang, pusty, etykieta, lista = false } = Astro.props;
---
{lista ? (
  wiersze.length === 0 ? (
    <p class="pt-pusto">{pusty}</p>
  ) : (
    <ul class="pt-list" aria-label={etykieta}>
      {wiersze.map((w) => (
        <li>
          <a class="pt-item" href={u(wJezyku(w.href, lang))}>
            <span class="pt-d pt-d-szer">{dayShort(w.termin, lang)} {short(w.termin).slice(0, 5)}<br />{time(w.termin)}</span>
            <span class="pt-b">
              <span class="pt-k">{w.seminarium}{sala(w.sala, lang) && <span class="pt-k-m"> · {sala(w.sala, lang)}</span>}</span>
              <span class="pt-t">{w.tytul}</span>
              <span class="pt-s">{w.prelegent}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
) : (
  <div class="sem-table" role="table" aria-label={etykieta}>
    {wiersze.length === 0 && <p class="sem-empty">{pusty}</p>}
    {wiersze.map((w) => (
      <a class="sem-row" role="row" href={u(wJezyku(w.href, lang))}>
        <span class="day" role="cell">{dayShort(w.termin, lang)} {short(w.termin).slice(0, 5)}</span>
        <span class="time" role="cell">{time(w.termin)}</span>
        <span class="room" role="cell">{sala(w.sala, lang) ?? ''}</span>
        <span class="sem" role="cell">{w.seminarium}</span>
        <span class="talk" role="cell"><b>{w.tytul}</b><span> — {w.prelegent}</span></span>
      </a>
    ))}
  </div>
)}
