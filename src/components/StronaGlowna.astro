---
// Strona główna (wspólna dla wersji polskiej i angielskiej).
import Baza from '../layouts/Baza.astro';
import Ikona from './Ikona.astro';
import KartaWydarzenia from './KartaWydarzenia.astro';
import TabelaReferatow from './TabelaReferatow.astro';
import KafelekKoloryDni from './KafelekKoloryDni.astro';
import WartoWiedziec from './WartoWiedziec.astro';
import ustawienia from '../data/ustawienia.json';
import skroty from '../data/skroty.json';
import { u, isExternal } from '../lib/url';
import { t, wJezyku, wybierz, RODZAJE, ODBIORCY } from '../lib/i18n';
import { range, short, type Lang } from '../lib/daty';
import { listaKierunkow } from '../lib/menu';
import { wydarzeniaNaGlowna, aktualnosciNaGlowna, wyroznionaAktualnosc, referatyWTygodniu, tydzienSeminariow } from '../lib/tresci';

interface Props { lang: Lang }
const { lang } = Astro.props;
const href = (a: string) => (isExternal(a) ? a : u(wJezyku(a, lang)));
// Kafelek „Na skróty” z tym adresem pokazuje dzisiejszy kolor dnia (KafelekKoloryDni).
const KOLORY_DNI = '/studia/rok-akademicki';

// Wydarzenia tylko, gdy są blisko (domyślnie 5 dni roboczych przed początkiem) — inaczej sekcji nie ma.
const dniWydarzen = Number((ustawienia as any).wydarzenia_dni_robocze ?? 5) || 5;
const wydarzenia = await wydarzeniaNaGlowna(3, lang, dniWydarzen);
const wyrozniona = await wyroznionaAktualnosc(lang);
// Wariant „Portal”: więcej aktualności (zwarta lista: data, rodzaj lub adresat, tytuł; miniatura, gdy wpis ma zdjęcie).
const aktualnosci = await aktualnosciNaGlowna(11, lang, wydarzenia.map((w) => w.href));
const etykieta = (p: (typeof aktualnosci)[number]) =>
  p.rodzaj !== 'ogloszenie' ? RODZAJE[p.rodzaj]?.[lang] : p.dla[0] ? ODBIORCY[p.dla[0]]?.[lang] : RODZAJE.ogloszenie[lang];
const referaty = await referatyWTygodniu(lang);
const tydzien = tydzienSeminariow();
const baner = ustawienia.baner;
const st = ustawienia.studia;
// Kafelki „Studia”: kierunki z sekcji Kierunki (pole „Pokaż na stronie głównej”) + dodatkowe kafelki z Ustawień.
const kafelki = [
  ...(await listaKierunkow()).filter((k) => k.data.na_stronie_glownej).map((k) => ({
    poziom: k.data.kafelek_poziom || 'Kierunek',
    poziom_en: k.data.kafelek_poziom_en || 'Programme',
    nazwa: k.data.menu_etykieta || k.data.nazwa,
    nazwa_en: k.data.menu_etykieta_en || k.data.nazwa_en,
    opis: k.data.kafelek_opis || k.data.opis || '',
    opis_en: k.data.kafelek_opis_en || k.data.opis_en,
    adres: `/studia/${k.id}`,
  })),
  ...((st.kierunki ?? []) as any[]),
];
---
<Baza tytul={t(lang, 'instytut')} stronaGlowna>
  {/* Baner: zdjęcie na całą szerokość, tekst na przyciemnieniu z lewej (na telefonie pod zdjęciem). Style: global.css, „baner (strona główna)”. */}
  <section class:list={['hero', { 'hero-bez-zdjecia': !baner.zdjecie }]} aria-labelledby="h1-glowna">
    {baner.zdjecie && (
      <figure class="hero-fig">
        <img
          src={u(baner.zdjecie)}
          srcset={(baner as any).zdjecie_male ? `${u((baner as any).zdjecie_male)} 1200w, ${u(baner.zdjecie)} 2400w` : undefined}
          sizes="100vw"
          alt={baner.opis}
          style={`object-position:${baner.kadr || 'center'}`}
          fetchpriority="high"
        />
        {baner.podpis && <figcaption>{baner.podpis}</figcaption>}
      </figure>
    )}
    <div class="wrap hero-in">
      <div class="hero-txt">
        {wyrozniona && (
          <a class="hero-flag" href={href(wyrozniona.href)}>{wyrozniona.tytul}<Ikona nazwa="strzalka" rozmiar={15} /></a>
        )}
        <span class="hero-logo" role="img" aria-label={t(lang, 'uwr')} style={`--logo-pelne:url(${u('/pliki/uwr-logo.png')})`}></span>
        <h1 id="h1-glowna">{t(lang, 'instytut')}</h1>
        <p class="hero-lead">{lang === 'en' ? ustawienia.wstep_en : ustawienia.wstep}</p>
        <div class="btn-row hero-btns">
          {ustawienia.przyciski.map((b, i) => (
            <a class={`btn${i === 0 ? ' btn-primary' : ''}`} href={href(b.adres)}>
              {wybierz(b, 'etykieta', lang)}{i === 0 && <Ikona nazwa="strzalka" rozmiar={16} />}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Wariant „Portal”: zaraz pod banerem trzy kolumny — aktualności | wydarzenia, seminaria tygodnia i „Warto wiedzieć” | na skróty i studia.
       Na telefonie kolumny układają się jedna pod drugą. Style: src/styles/portal.css i <style> poniżej. */}
  <div class="pt-sekcja pt-glowna">
    <div class="wrap pt-grid">
      <section class="pt-box pt-akt" aria-labelledby="h2-akt">
        <div class="pt-h">
          <h2 id="h2-akt">{t(lang, 'aktualnosci')}</h2>
          <a class="pt-all" href={href('/aktualnosci')}>{t(lang, 'wszystkieAktualnosci')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
        </div>
        <ul class="pt-list">
          {aktualnosci.map((p) => (
            <li>
              <a class="pt-item" href={href(p.href)}>
                <time class="pt-d" datetime={p.data}>{short(p.data).slice(0, 5)}</time>
                <span class="pt-b">
                  <span class="pt-k">{etykieta(p)}</span>
                  <span class="pt-t">{p.tytul}</span>
                </span>
                {p.zdjecie && <span class="pt-min"><img src={u(p.zdjecie)} alt="" loading="lazy" decoding="async" /></span>}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <div class="pt-col">
        {wydarzenia.length > 0 && (
          <section class="pt-box" aria-labelledby="h2-wyd" data-wydarzenia>
            <div class="pt-h">
              <h2 id="h2-wyd">{t(lang, 'najblizsze')}</h2>
              <a class="pt-all" href={href('/kalendarz')}>{t(lang, 'kalendarz')}<Ikona nazwa="strzalka" rozmiar={14} /></a>
            </div>
            <ul class="pt-list">
              {wydarzenia.map((w) => <KartaWydarzenia w={w} lang={lang} wiersz />)}
            </ul>
          </section>
        )}
        <section class="pt-box" aria-labelledby="h2-sem">
          <div class="pt-h">
            <span class="pt-h-l">
              <h2 id="h2-sem">{t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien')}</h2>
              <span class="pt-zakres">{range(tydzien.od, tydzien.do, lang)}</span>
            </span>
          </div>
          <TabelaReferatow
            lista
            wiersze={referaty}
            lang={lang}
            etykieta={t(lang, tydzien.przyszly ? 'seminariaPrzyszly' : 'seminariaTydzien')}
            pusty={t(lang, tydzien.przyszly ? 'brakReferatowPrzyszly' : 'brakReferatow')}
          />
          <p class="pt-stopka"><a class="pt-all" href={href('/seminaria')}>{t(lang, 'wszystkieSeminaria')}<Ikona nazwa="strzalka" rozmiar={14} /></a></p>
        </section>
        <WartoWiedziec lang={lang} uklad="portal" glowna limit={4} />
      </div>

      <div class="pt-col pt-szeroka-sr">
        <section class="pt-box pt-skroty-box" aria-labelledby="h2-skroty">
          <div class="pt-h"><h2 id="h2-skroty">{t(lang, 'naSkroty')}</h2></div>
          <ul class="pt-skroty">
            {skroty.kafelki.map((k) => (
              <li>
                {k.adres === KOLORY_DNI ? (
                  <KafelekKoloryDni lang={lang} adres={k.adres} etykieta={wybierz(k, 'etykieta', lang)} />
                ) : (
                  <a class="tile" href={href(k.adres)}>
                    <Ikona nazwa={k.ikona} />
                    <span>{wybierz(k, 'etykieta', lang)}</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>

        <section class="pt-box" aria-labelledby="h2-studia">
          <div class="pt-h"><h2 id="h2-studia">{wybierz(st, 'tytul', lang)}</h2></div>
          <p class="pt-opis">{wybierz(st, 'opis', lang)}</p>
          <ul class="pt-list">
            {kafelki.map((k) => (
              <li>
                <a class="pt-item" href={href(k.adres)}>
                  <span class="pt-b">
                    <span class="pt-k">{wybierz(k, 'poziom', lang)}</span>
                    <span class="pt-t">{wybierz(k, 'nazwa', lang)}</span>
                    {wybierz(k, 'opis', lang) && <span class="pt-s">{wybierz(k, 'opis', lang)}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="pt-stopka"><a class="btn btn-accent btn-small" href={st.rekrutacja}>{t(lang, 'rekrutacja')}<Ikona nazwa="strzalka" rozmiar={15} /></a></p>
        </section>
      </div>
    </div>
  </div>

</Baza>

<script>
  // Strona przebudowuje się 2× dziennie — wydarzenia, które już się skończyły, chowamy od razu w przeglądarce.
  import { now, today, hasTime } from '../lib/daty';
  const sekcja = document.querySelector<HTMLElement>('[data-wydarzenia]');
  if (sekcja) {
    const n = now();
    const d = today();
    const karty = Array.from(sekcja.querySelectorAll<HTMLElement>('[data-koniec]'));
    karty.forEach((k) => {
      const koniec = k.dataset.koniec || '';
      if (koniec && (hasTime(koniec) ? koniec < n : koniec < d)) k.remove();
    });
    if (!sekcja.querySelector('[data-koniec]')) sekcja.remove();
  }
</script>

<style>
  /* „Na skróty” w kolumnie: kafelki jako wiersze (ikona z lewej, napis obok; kafelek koloru dnia z opisem pod napisem) */
  .pt-skroty { list-style: none; margin: 0; padding: 0; }
  .pt-skroty li + li { border-top: 1px solid var(--line); }
  .pt-skroty :global(.tile) { display: grid; grid-template-columns: 24px minmax(0, 1fr); align-items: center; gap: 0 12px; min-height: 44px; padding: 8px 6px; border-radius: 8px; background: transparent; font-size: 15px; line-height: 1.3; }
  .pt-skroty :global(.tile:hover) { background: var(--tint); }
  .pt-skroty :global(.tile .kd-pod) { grid-column: 2; margin-top: 1px; }
  .pt-glowna .pt-stopka { padding-top: 8px; }
  /* telefon: kolumny jedna pod drugą; „Na skróty” na samej górze (jak kafelki pod banerem), aktualności — sześć najnowszych */
  @media (max-width: 680px) {
    .pt-glowna .pt-col { display: contents; }
    .pt-glowna .pt-skroty-box { order: -1; }
    .pt-glowna .pt-akt .pt-list > li:nth-child(n + 7) { display: none; }
  }
</style>
